# Local / Vercel env. Copy to .env for local (gitignored).

# Data backend — supabase only after Base44 cutover
VITE_DATA_PROVIDER=supabase

# --- Supabase (browser / Vite only) ---
# From Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server converter features (URL import / AI assist). Keep false unless backends are ported.
# Optional locally — defaults to false if unset.
VITE_CONVERTER_SERVER_FEATURES=false

# Public site URL (optional; used for contact / legal branding if referenced)
# VITE_VERIDIAN_APP_URL=https://plexity.tools

# Server-only — used by Supabase Edge Functions / local scripts.
# NEVER prefix with VITE_ and NEVER commit real values.
# SUPABASE_SERVICE_ROLE_KEY=

# Official Brawl Stars API token (server only). Create at https://developer.brawlstars.com
# For RoyaleAPI public proxy: whitelist IP 45.79.218.79 on the token, then call via bsproxy
# (default in our proxy code). Do NOT put the IP in secrets — only the TOKEN string.
# BRAWL_STARS_API_TOKEN=
# Optional override (default is already the RoyaleAPI BS proxy):
# BRAWL_STARS_API_BASE=https://bsproxy.royaleapi.dev/v1

# Optional: point the Vite app at the local Node proxy while developing (npm run brawl:proxy).
# VITE_BRAWL_PROXY_URL=http://127.0.0.1:8788

# Dev script only — scripts/import-college-scorecard.mjs (not used by the app at runtime)
# COLLEGE_SCORECARD_API_KEY=
